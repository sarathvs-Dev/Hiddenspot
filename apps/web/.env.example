# Optional: enables the map view on the Explore page.
# Use a tile provider whose terms allow your usage. For light local development you may use
# OpenStreetMap's tiles, which require attribution and forbid heavy use:
#   https://operations.osmfoundation.org/policies/tiles/
# For production, use a commercial or self-hosted tile service.
#
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
